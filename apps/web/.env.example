# Base URL of @stockhub/api. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8787

# "true" = every screen reads from src/lib/mock-data.ts instead of the API.
# Set to "false" once the API is running to go fully live.
NEXT_PUBLIC_DEMO_MODE=true

# "true" = show the guided walkthrough (side panel, sample-file buttons,
# reset). The tour needs REAL numbers, so pair it with NEXT_PUBLIC_DEMO_MODE=false.
NEXT_PUBLIC_GUIDED_DEMO=false

# Org used by the demo auth headers (x-demo-org).
# Seeded demo org (packages/db/src/seed/data.ts SEED_IDS.org)
NEXT_PUBLIC_DEMO_ORG_ID=0a000000-0000-4000-8000-000000000001
NEXT_PUBLIC_DEMO_ORG_NAME=ร้านเกษตรรุ่งเรือง
