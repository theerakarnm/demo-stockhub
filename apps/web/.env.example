# Base URL of @stockhub/api. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8787

# "true" = every screen reads from src/lib/mock-data.ts instead of the API.
# Set to "false" once the API is running to go fully live.
NEXT_PUBLIC_DEMO_MODE=true

# Org used by the demo auth headers (x-demo-org). Placeholder value only.
NEXT_PUBLIC_DEMO_ORG_ID=org_demo_0001
NEXT_PUBLIC_DEMO_ORG_NAME=ร้านเกษตรรุ่งเรือง
