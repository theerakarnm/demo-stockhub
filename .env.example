# ---------------------------------------------------------------------------
# StockHub - copy to .env and fill in. Never commit the filled file.
# API-side secrets belong in apps/api/.dev.vars (see .dev.vars.example).
# ---------------------------------------------------------------------------

# PostgreSQL (docker compose up -d starts a matching instance)
DATABASE_URL=postgresql://stockhub:stockhub@localhost:5435/stockhub

# Web -> API
NEXT_PUBLIC_API_URL=http://localhost:8787

# Demo auth: the web app sends the acting role to the API.
# Real auth replaces this. See packages/core/src/rbac.ts
NEXT_PUBLIC_DEMO_MODE=true
