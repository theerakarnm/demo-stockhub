{
  "name": "stockhub",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @stockhub/web dev",
    "dev:api": "bun run --filter @stockhub/api dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun test",
    "db:generate": "bun run --filter @stockhub/db generate",
    "db:migrate": "bun run --filter @stockhub/db migrate",
    "db:push": "bun run --filter @stockhub/db push",
    "db:studio": "bun run --filter @stockhub/db studio",
    "db:seed": "bun run --filter @stockhub/db seed",
    "docker:up": "podman-compose up -d",
    "docker:down": "podman-compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
